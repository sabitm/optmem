#!/usr/bin/env python3
"""OptMem: a persistent memory for AI agents.

  {memo} init             create this memory; print manual-use instructions.
  {memo} skill            print a manual-only SKILL.md for this installation.
  {memo} wake [part [T [revision]]] load memory after explicit activation.
  {memo} note "..."       record one memory: one short line.
  {memo} edit <id> "..."  replace a memory's text; keep its id and date.
  {memo} delete <id>      delete a memory permanently; keep other ids.
  {memo} nap [id "..." [revision]] do the pending compressions.
  {memo} recall <regex>   search all current memories.
  {memo} zoom <lo>-<hi>   open a tree node: its two halves.
  {memo} forget <lo>-<hi> drop a bad summary; nap rebuilds it.
  {memo} config [NAME=N]  show this memory's sizes, or change one.
  {memo} import <file>    bulk-load dated memories (bootstrap only).
  {memo} migrate          upgrade an existing store to larger records.

Memories live in memory/ beside the executable. Unmanaged copies may use
$MEMORY_DIR. Installer-managed copies always use their own memory/ directory.
See github.com/VictorTaelin/OptMem.
"""

import ast
import datetime
import errno
try:
    import fcntl
except ImportError:
    fcntl = None  # Windows has no fcntl; we fall back to msvcrt below
import hashlib
import json
import os
import re
import runpy
import shlex
import shutil
import stat
import sys
import tempfile
from collections import deque


# The store is UTF-8 by construction, so the tool reads and prints UTF-8
# no matter what the machine's locale says. Without this, one arrow in a
# memory makes wake crash on a latin-1 locale.
for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):  # Python 3.7+
        _s.reconfigure(encoding="utf-8")


def pretty(p):
    """A path as the user would type it: keep symlinks, fold $HOME to ~."""
    p, home = os.path.abspath(p), os.path.expanduser("~")
    return "~" + p[len(home):] if p.startswith(home + os.sep) else p


# Every command this tool prints has to RUN. After `curl | sh` nothing is on
# PATH, so a bare `memo nap 0-1 "..."` would not: the tool names itself.
EXECUTABLE = os.path.realpath(__file__)
ME = shlex.quote(EXECUTABLE)

# The sizes a memory may override in its own `config` file: the default, and
# what it means. `memo config` shows and edits them. The globals below start
# at these defaults, so a memory that overrides nothing follows the tool.
KNOBS = {
    "WAKE_LINES": (96, "the memory context: how many lines wake prints"),
    "ENTRY_CHARS": (2048, "the longest one memory may be, in UTF-8 bytes"),
    "SUMMARY_CHARS": (560, "the longest summary may be, in UTF-8 bytes"),
    "PART_CHARS": (20000, "output paging: largest part, in bytes"),
    "PART_LINES": (500, "output paging: largest part, in lines"),
}
WAKE_LINES = KNOBS["WAKE_LINES"][0]
ENTRY_CHARS = KNOBS["ENTRY_CHARS"][0]
SUMMARY_CHARS = KNOBS["SUMMARY_CHARS"][0]
# Every harness truncates a command that prints too much, and each drops a
# different piece: Claude Code cuts the middle at 30,000 chars, pi cuts the
# head at 50 KB, Codex budgets 10,000 tokens. So the memory is handed over in
# parts that fit all of them. These are transport limits, not memory limits.
PART_CHARS = KNOBS["PART_CHARS"][0]
PART_LINES = KNOBS["PART_LINES"][0]

RAW_MAX = 16
RAW_BYTES = 8192  # larger raw bodies compress from their child summaries


# Records are FIXED WIDTH, so a memory or a block is found by seeking to its
# offset -- no scanning, no index file to keep in sync. Position IS identity:
# memory i lives at i*LOG_REC of LOG.txt, and block [k*s,(k+1)*s) lives at
# k*TREE_REC of TREE/<s>. A deleted memory keeps its original position.
FORMATS = {1: (320, 288, 280, 280), 2: (2112, 576, 2048, 560)}
STORE_VERSION = 2
LOG_REC, TREE_REC = FORMATS[STORE_VERSION][:2]
# Blank summaries mean corruption. Empty blocks need a distinct marker.
EMPTY_SUMMARY = "\x00"


# ---------------------------------------------------------------- blocks

# A BLOCK is an aligned power-of-two range of memories, [lo,hi), compressed
# into one line. Blocks form a binary merge tree over LOG.txt: block [lo,hi)
# is the compression of [lo,mid) and [mid,hi).

def _cover(T, alpha):
    """Tile [0,T) with aligned power-of-two blocks; keep a block whole iff its
    size is at most `alpha` times its age. Bigger alpha = coarser = fewer
    lines."""
    root = 1
    while root < T:
        root *= 2
    out, stack = [], [(0, root)]
    while stack:
        lo, hi = stack.pop()
        if lo >= T:
            continue
        size = hi - lo
        if size > 1 and (hi > T or size > alpha * (T - lo)):
            mid = (lo + hi) // 2
            stack.append((mid, hi))
            stack.append((lo, mid))
        else:
            out.append((lo, hi))
    out.sort()
    return out


def cover(T, budget):
    """The blocks `memo wake` prints: at most `budget` of them, finest near T.

    Detail decays with age, so recent memories stay verbatim and ancient ones
    collapse. If everything fits, nothing is compressed at all."""
    if T <= 0:
        return []
    if T <= budget:
        return [(i, i + 1) for i in range(T)]
    lo, hi = 0.0, 1.0
    for _ in range(60):
        mid = (lo + hi) / 2
        if len(_cover(T, mid)) > budget:
            lo = mid
        else:
            hi = mid
    out = _cover(T, hi)
    # Block sizes jump in powers of two, so alpha alone can undershoot the
    # budget. Spend what is left on the present, where detail is worth most.
    while len(out) < budget:
        i = max((i for i, b in enumerate(out) if b[1] - b[0] > 1), default=None)
        if i is None:
            break
        lo_, hi_ = out[i]
        mid = (lo_ + hi_) // 2
        out[i:i + 1] = [(lo_, mid), (mid, hi_)]
    return out


# ---------------------------------------------------------------- store

def installation_managed(directory=None):
    p = os.path.join(directory or os.path.dirname(EXECUTABLE), ".optmem-install")
    if not os.path.lexists(p):
        return False
    if not stat.S_ISREG(os.lstat(p).st_mode):
        die("%s must be a regular installation marker." % pretty(p))
    try:
        with open(p, encoding="utf-8") as f:
            value = json.load(f)
        if (not isinstance(value, dict) or set(value) != {"version"}
                or type(value["version"]) is not int or value["version"] != 1):
            raise ValueError()
    except (ValueError, UnicodeError):
        die("%s is corrupt. Restore it from a backup, or remove the damaged "
            "marker deliberately before reinstalling." % pretty(p))
    return True


def memory_dir():
    base = os.path.dirname(EXECUTABLE)
    override = None if installation_managed() else os.environ.get("MEMORY_DIR")
    return os.path.abspath(os.path.expanduser(override or os.path.join(base, "memory")))


def shell_command(executable, data=None):
    if any(c in executable or (data is not None and c in data) for c in "\r\n"):
        die("Installation and memory paths must not contain line breaks.")
    command = shlex.quote(executable)
    if data is not None:
        command = "MEMORY_DIR=%s %s" % (shlex.quote(data), command)
    return command


def bind_command(d):
    global ME
    ME = shell_command(EXECUTABLE, None if installation_managed()
                       else os.path.abspath(os.path.expanduser(d)))


def store():
    d = memory_dir()
    # The directory is only ever created by `memo init`: creating it IS
    # creating the identity, and that is a deliberate act. If any other
    # command created it, a typo in MEMORY_DIR would silently open an empty
    # store, and the agent would wake with no past and write a second
    # identity.
    if not os.path.isdir(d):
        hint = ("Use this installation's own memory directory."
                if installation_managed() else
                "To use an existing one, point MEMORY_DIR at it.")
        die("No memory at %s.\nTo create one, run: %s init\n%s" % (d, ME, hint))
    os.makedirs(os.path.join(d, "TREE"), exist_ok=True)
    return d


def read_format(d):
    p = os.path.join(d, ".format")
    try:
        with open(p, encoding="utf-8") as f:
            value = json.load(f)
    except FileNotFoundError:
        return 1
    except (ValueError, UnicodeError):
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    if (not isinstance(value, dict) or type(value.get("version")) is not int
            or value["version"] != 2):
        die("%s has an unsupported format. Use a compatible script or restore "
            "a backup." % pretty(p))
    return value["version"]


def load_format(d):
    global STORE_VERSION, LOG_REC, TREE_REC
    STORE_VERSION = read_format(d)
    LOG_REC, TREE_REC = FORMATS[STORE_VERSION][:2]


def defaults():
    out = {k: v[0] for k, v in KNOBS.items()}
    out["ENTRY_CHARS"], out["SUMMARY_CHARS"] = FORMATS[STORE_VERSION][2:]
    return out


def prepare(d):
    recover_migration(d)
    load_format(d)
    if not os.path.exists(log_path(d)):
        open(log_path(d), "ab").close()
    recover(d)


def size(k, v, where=""):
    """Validate one knob, wherever it came from: the config file or argv. A
    bad knob stops every command, so the message has to say where it is
    written -- `memo config` cannot fix a file it also refuses to read."""
    if not v.isdigit() or int(v) < 1:
        die("%s%s must be a positive whole number, not '%s'." % (where, k, v))
    caps = {"ENTRY_CHARS": FORMATS[STORE_VERSION][2],
            "SUMMARY_CHARS": FORMATS[STORE_VERSION][3]}
    if k in caps and int(v) > caps[k]:
        migrate = " Run: %s migrate" % ME if STORE_VERSION == 1 else ""
        die("%s%s is at most %d in format %d.%s"
            % (where, k, caps[k], STORE_VERSION, migrate))
    return int(v)


def overrides(d):
    """The knobs this memory sets for itself, read from its `config` file."""
    out = {}
    p = os.path.join(d, "config")
    if not os.path.exists(p):
        return out
    for n, line in enumerate(open(p, encoding="utf-8"), 1):
        line = line.split("#")[0].strip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip().upper(), v.strip()
        where = "%s line %d: " % (pretty(p), n)
        if k not in KNOBS:
            die("%s%s is not a size. Delete the line, or name one of: %s."
                % (where, k, ", ".join(KNOBS)))
        out[k] = size(k, v, where)
    return out


def config(d):
    """Reset defaults for this format before applying this store's overrides."""
    globals().update(defaults())
    for k, v in overrides(d).items():
        globals()[k] = v  # a knob's name IS the name of the global it sets


def write_config(d, over):
    """Rewrite `config`: every knob on its own line, commented out unless this
    memory overrides it."""
    out = ["# OptMem sizes for this memory. A commented line means: follow the",
           "# tool's default. Edit with `%s config NAME=VALUE`." % ME, ""]
    for k, (_, what) in KNOBS.items():
        default = defaults()[k]
        out.append("%-2s%-12s = %-6d # %s"
                   % ("" if k in over else "# ", k, over.get(k, default), what))
    with open(os.path.join(d, "config"), "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def log_path(d):
    return os.path.join(d, "LOG.txt")


def tree_path(d, size):
    return os.path.join(d, "TREE", str(size))


def count(path, rec):
    try:
        return os.path.getsize(path) // rec
    except FileNotFoundError:  # any other failure is real and must surface
        return 0


def log_len(d):
    return count(log_path(d), LOG_REC)


def repair(path, rec):
    """Drop a partial trailing record left by a crash. It was never
    acknowledged. Without this the next append lands at a wrong offset and
    every later record is misaligned. Callers hold the lock."""
    try:
        n = os.path.getsize(path)
    except FileNotFoundError:
        return
    if n % rec:
        with open(path, "r+b") as f:
            f.truncate(n - n % rec)


def parse(line):
    head, _, rest = line.partition(" ")
    date, _, text = rest.partition(" ")
    return int(head[1:]), date, text


def records(buf):
    """Decode a run of log records. They are sliced as BYTES and decoded one
    by one -- slicing decoded text would shift every boundary after the first
    multi-byte character."""
    return [parse(buf[i * LOG_REC:(i + 1) * LOG_REC].decode().rstrip())
            for i in range(len(buf) // LOG_REC)]


def log_slice(d, lo, hi):
    """Memories [lo,hi) in one read."""
    with open(log_path(d), "rb") as f:
        f.seek(lo * LOG_REC)
        return records(f.read((hi - lo) * LOG_REC))


def log_get(d, i):
    """(id, date, text) of memory i, in one seek."""
    return log_slice(d, i, i + 1)[0]


def log_scan(d):
    """Every memory, streamed without loading the entire log into RAM."""
    with open(log_path(d), "rb") as f:
        while True:
            buf = f.read(LOG_REC * 4096)
            if not buf:
                return
            for e in records(buf):
                yield e


def tree_get(d, lo, hi):
    """The summary of block [lo,hi), in one seek. None if not built yet."""
    size = hi - lo
    try:
        with open(tree_path(d, size), "rb") as f:
            f.seek((lo // size) * TREE_REC)
            rec = f.read(TREE_REC)
    except FileNotFoundError:  # not built yet; any other failure is real
        return None
    try:
        return rec.decode().rstrip() or None
    except UnicodeDecodeError:
        die("The summary of #%d-%d is corrupt. Run: %s forget %d-%d"
            % (lo, hi - 1, ME, lo, hi - 1))


def pad(text, rec):
    b = text.encode()
    if len(b) > rec - 1:
        die("Too long: %d bytes. The record holds %d." % (len(b), rec - 1))
    return b + b" " * (rec - 1 - len(b)) + b"\n"


def locked(d):
    # Open in append mode ("a"), NOT "w": reopening with "w" truncates the
    # lock file and breaks advisory locks held by other processes on Windows.
    lock = open(os.path.join(d, ".lock"), "a")
    if fcntl is not None:
        fcntl.flock(lock, fcntl.LOCK_EX)
    else:
        # Windows: no fcntl. Use msvcrt advisory lock with spin/backoff so
        # parallel sessions (the documented multi-process case) queue instead
        # of raising "Resource deadlock avoided" under contention.
        import msvcrt as _ms
        import time as _t
        waited = 0.0
        while True:
            try:
                _ms.locking(lock.fileno(), _ms.LK_NBLCK, 1)
                break
            except OSError:
                if waited > 30.0:
                    raise
                _t.sleep(min(0.01 + waited * 0.2, 0.25))
                waited += 0.01
        _orig_close = lock.close
        def _close():
            try:
                _ms.locking(lock.fileno(), _ms.LK_UNLCK, 1)
            except Exception:
                pass
            _orig_close()
        lock.close = _close
    return lock


def log_append(d, items):
    """Append under the command lock, assigning ids from the record count."""
    repair(log_path(d), LOG_REC)
    base = log_len(d)
    with open(log_path(d), "ab") as f:
        for k, (date, text) in enumerate(items):
            f.write(pad("#%d %s %s" % (base + k, date, text), LOG_REC))
        f.flush()
        os.fsync(f.fileno())
    return base


def tree_put(d, lo, hi, text):
    """Append one summary under the command lock, preserving a dense prefix."""
    size = hi - lo
    p = tree_path(d, size)
    repair(p, TREE_REC)
    if count(p, TREE_REC) != lo // size:
        return False
    with open(p, "ab") as f:
        f.write(pad(text, TREE_REC))
        f.flush()
        os.fsync(f.fileno())
    return True


def tree_drop(d, lo, hi):
    """Truncate affected levels under the command lock, including later blocks."""
    gone, first, size = 0, None, hi - lo
    while size <= log_len(d):
        p, k = tree_path(d, size), lo // size
        n = count(p, TREE_REC)
        if n > k:
            if first is None:
                first = (k * size, (k + 1) * size)
            gone += n - k
            with open(p, "r+b") as f:
                f.truncate(k * TREE_REC)
                f.flush()
                os.fsync(f.fileno())
        size *= 2
    return gone, first


def sync_dir(d):
    if os.name != "nt":
        fd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def atomic_write(path, data):
    directory = os.path.dirname(path)
    fd, staged = tempfile.mkstemp(prefix="." + os.path.basename(path) + "-", dir=directory)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(staged, path)
        sync_dir(directory)
    finally:
        if os.path.exists(staged):
            os.unlink(staged)


def file_digest(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for buf in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(buf)
    return digest.hexdigest()


def recover_migration(d):
    p = os.path.join(d, ".migration")
    try:
        with open(p, encoding="utf-8") as f:
            change = json.load(f)
    except FileNotFoundError:
        return
    except (ValueError, UnicodeError):
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    if os.path.exists(os.path.join(d, ".pending")):
        die("Both .migration and .pending exist. Restore a consistent backup "
            "before continuing.")
    try:
        if (not isinstance(change, dict)
                or any(type(change.get(k)) is not int or change[k] != v
                       for k, v in (("version", 1), ("from", 1), ("to", 2)))
                or type(change.get("revision")) is not int
                or change["revision"] < 1 or not isinstance(change.get("files"), list)
                or not change["files"]):
            raise ValueError()
        seen = set()
        for item in change["files"]:
            name, n, digest = (item[k] for k in ("path", "bytes", "sha256"))
            if not isinstance(name, str) or name in seen:
                raise ValueError()
            if name == "LOG.txt":
                width = FORMATS[2][0]
            else:
                m = re.fullmatch(r"TREE/([1-9]\d*)", name)
                level = int(m[1]) if m else 0
                if level < 2 or level & (level - 1):
                    raise ValueError()
                width = FORMATS[2][1]
            if (type(n) is not int or n < 0 or n % width
                    or not isinstance(digest, str)
                    or not re.fullmatch(r"[0-9a-f]{64}", digest)):
                raise ValueError()
            seen.add(name)
        if "LOG.txt" not in seen:
            raise ValueError()
        for folder in (os.path.join(d, "TREE"), os.path.join(d, ".migrate", "TREE")):
            if os.path.isdir(folder):
                for name in os.listdir(folder):
                    if re.fullmatch(r"[1-9]\d*", name):
                        level = int(name)
                        if (level >= 2 and not level & (level - 1)
                                and "TREE/" + name not in seen):
                            raise ValueError()
    except (ValueError, TypeError, KeyError):
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    current = revision(d)
    target = change["revision"]
    if current not in (target - 1, target):
        die("%s has an unexpected revision. Restore it from a backup." % pretty(p))
    version = read_format(d)
    if current == target and version != 2:
        die("%s has an inconsistent format. Restore it from a backup." % pretty(p))
    stage = os.path.join(d, ".migrate")
    # Preflight every remaining source before replacing anything. Once a file
    # is renamed, its target is the only copy and must match the manifest.
    for item in change["files"]:
        source = os.path.join(stage, item["path"])
        if not os.path.exists(source):
            source = os.path.join(d, item["path"])
        if (not os.path.isfile(source) or os.path.getsize(source) != item["bytes"]
                or file_digest(source) != item["sha256"]):
            die("Migration data at %s is missing or corrupt. Restore a backup."
                % pretty(source))
    for item in change["files"]:
        source = os.path.join(stage, item["path"])
        if os.path.exists(source):
            dest = os.path.join(d, item["path"])
            os.replace(source, dest)
            sync_dir(os.path.dirname(dest))
            sync_dir(os.path.dirname(source))
    if version != 2:
        atomic_write(os.path.join(d, ".format"), b'{"version": 2}\n')
    if current != target:
        atomic_write(os.path.join(d, ".revision"), (str(target) + "\n").encode())
    if os.path.isdir(stage):
        shutil.rmtree(stage)
        sync_dir(d)
    os.unlink(p)
    sync_dir(d)


def stage_records(source, dest, old_width, new_width, log=False):
    digest, total, index = hashlib.sha256(), 0, 0
    with open(source, "rb") as src, open(dest, "wb") as dst:
        os.chmod(dest, os.stat(source).st_mode & 0o777)
        while True:
            buf = src.read(old_width)
            if len(buf) < old_width:
                break  # a partial tail was never acknowledged
            try:
                text = buf.decode("utf-8").rstrip()
                if log:
                    i, date, _ = parse(text)
                    if i != index:
                        raise ValueError()
                    datetime.datetime.strptime(date, "%Y-%m-%d")
            except (ValueError, UnicodeError):
                die("Cannot migrate %s: record %d is corrupt. Restore a backup "
                    "or use forget for a corrupt summary." % (pretty(source), index))
            rec = pad(text, new_width)
            dst.write(rec)
            digest.update(rec)
            total += len(rec)
            index += 1
        dst.flush()
        os.fsync(dst.fileno())
    return {"bytes": total, "sha256": digest.hexdigest()}


def cmd_migrate(d, args):
    if args:
        die("usage: %s migrate" % ME)
    if STORE_VERSION == 2:
        print("Already format 2. No migration needed.")
        return
    # No journal means no target was replaced. An interrupted staging pass
    # can be discarded, but committed staging must only be rolled forward.
    stage = os.path.join(d, ".migrate")
    if os.path.isdir(stage):
        shutil.rmtree(stage)
    os.makedirs(os.path.join(stage, "TREE"))
    names = ["LOG.txt"]
    levels = []
    for name in os.listdir(os.path.join(d, "TREE")):
        if re.fullmatch(r"[1-9]\d*", name):
            level = int(name)
            if level >= 2 and not level & (level - 1):
                levels.append(level)
    names += ["TREE/%d" % n for n in sorted(levels)]
    files = []
    for name in names:
        is_log = name == "LOG.txt"
        old_width, new_width = ((LOG_REC, FORMATS[2][0]) if is_log
                                else (TREE_REC, FORMATS[2][1]))
        item = stage_records(os.path.join(d, name), os.path.join(stage, name),
                             old_width, new_width, log=is_log)
        item["path"] = name
        files.append(item)
    sync_dir(os.path.join(stage, "TREE"))
    sync_dir(stage)
    sync_dir(d)
    change = {"version": 1, "from": 1, "to": 2,
              "revision": revision(d) + 1, "files": files}
    atomic_write(os.path.join(d, ".migration"),
                 (json.dumps(change) + "\n").encode())
    recover_migration(d)
    load_format(d)
    config(d)
    print("Migrated to format 2: %d memory slots, ids and dates unchanged."
          % log_len(d))
    print("Memory limit: %d bytes. Summary limit: %d bytes."
          % (ENTRY_CHARS, SUMMARY_CHARS))
    print("Run: %s init  # print updated agent instructions" % ME)


def revision(d):
    p = os.path.join(d, ".revision")
    try:
        with open(p, encoding="ascii") as f:
            value = f.read().strip()
    except FileNotFoundError:
        return 0
    except UnicodeDecodeError:
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    if not value.isdigit():
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    return int(value)


def require_revision(d, value):
    current = revision(d)
    if value is None and current == 0:
        return
    if value is None or not value.isdigit() or int(value) != current:
        die("The memory changed, or its revision is missing. "
            "Run: %s wake\nFor a fresh compression, run: %s nap" % (ME, ME))


def replace_record(d, i, date, text):
    # Rewrite and rename instead of overwriting a shared disk sector. A torn
    # in-place write could damage adjacent memories, not just the edited one.
    p = os.path.join(d, ".LOG.tmp")
    with open(log_path(d), "rb") as src, open(p, "wb") as dst:
        os.chmod(p, os.stat(log_path(d)).st_mode & 0o777)
        left = i * LOG_REC
        while left:
            buf = src.read(min(left, 1024 * 1024))
            if not buf:
                die("LOG.txt is shorter than the pending change expects.")
            dst.write(buf)
            left -= len(buf)
        dst.write(pad("#%d %s %s" % (i, date, text), LOG_REC))
        src.seek((i + 1) * LOG_REC)
        shutil.copyfileobj(src, dst)
        dst.flush()
        os.fsync(dst.fileno())
    os.replace(p, log_path(d))
    sync_dir(d)


def recover(d):
    """Replay a durable change before any command can read or write the store."""
    p = os.path.join(d, ".pending")
    try:
        with open(p, encoding="utf-8") as f:
            change = json.load(f)
        if not isinstance(change, dict):
            raise ValueError()
        i, date, text, target = (change[k] for k in
                                 ("id", "date", "text", "revision"))
        valid = (change.get("version") == 1 and type(i) is int
                 and 0 <= i < log_len(d) and type(target) is int and target > 0
                 and isinstance(date, str) and isinstance(text, str)
                 and re.fullmatch(r"\d{4}-\d{2}-\d{2}", date)
                 and not any(c in text for c in "\r\n\x00")
                 and len(("#%d %s %s" % (i, date, text)).encode()) < LOG_REC)
        if not valid:
            raise ValueError()
        datetime.datetime.strptime(date, "%Y-%m-%d")
    except FileNotFoundError:
        return
    except (ValueError, KeyError, TypeError, UnicodeError):
        die("%s is corrupt. Restore it from a backup before continuing."
            % pretty(p))
    current = revision(d)
    if target == current + 1:
        tree_drop(d, i // 2 * 2, i // 2 * 2 + 2)
        replace_record(d, i, date, text)
        atomic_write(os.path.join(d, ".revision"), (str(target) + "\n").encode())
    elif target != current:
        die("%s has an unexpected revision. Restore it from a backup."
            % pretty(p))
    # The revision is the commit marker. Never invalidate summaries again
    # once it matches: another command may already have rebuilt them.
    os.unlink(p)
    sync_dir(d)


def change_memory(d, i, text):
    _, date, _ = log_get(d, i)
    change = {"version": 1, "id": i, "date": date, "text": text,
              "revision": revision(d) + 1}
    atomic_write(os.path.join(d, ".pending"),
                 (json.dumps(change, ensure_ascii=False) + "\n").encode())
    recover(d)


def execute(d, cmd, args):
    bind_command(d)
    if cmd == "skill":
        return cmd_skill(d, args)
    if cmd == "init":
        return cmd_init(d, args)
    lock = locked(d)
    try:
        prepare(d)
        config(d)
        return COMMANDS[cmd](d, args)
    finally:
        lock.close()


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def plural(n, word):
    if n == 1:
        return "1 " + word
    if word.endswith("y"):
        word = word[:-1] + "ie"
    elif word.endswith(("s", "h", "x")):
        word += "e"
    return "%d %ss" % (n, word)


def block_id(s):
    """Parse `<lo>-<hi>` as wake and the nap prompts print it: inclusive at
    both ends, and a real block -- an aligned power-of-two range. Without the
    shape check, `4-5` and `5-6` read the same record."""
    m = re.fullmatch(r"(\d+)-(\d+)", s)
    if not m:
        die("'%s' is not a block id. Copy it from the prompt." % s)
    lo, hi = int(m.group(1)), int(m.group(2)) + 1
    n = hi - lo
    if n < 2 or n & (n - 1) or lo % n:
        die("%s is not a block. Copy the id printed by wake, like 16-31." % s)
    return lo, hi


def check(text, summary=False):
    text = text.strip()
    if not text:
        die("Empty. A memory is one line of text.")
    if "\x00" in text:
        die("NUL bytes are reserved for empty summaries.")
    if "\n" in text or "\r" in text:
        die("%d lines. A memory is one line: merge them, or note them "
            "separately." % (text.count("\n") + 1))
    limit = SUMMARY_CHARS if summary else ENTRY_CHARS
    n = len(text.encode())
    if n > limit:
        die("Too long: %d bytes, limit %d. UTF-8 characters use one to four "
            "bytes. Compress it further." % (n, limit))
    return text


# ---------------------------------------------------------------- naps

def pending(d, T, limit=None):
    """Blocks that can be built and have not been, smallest first. Each level
    file holds a dense prefix, so its length says exactly how far that level
    got: this costs one stat per level, never a scan."""
    todo, size = [], 2
    while size <= T:
        have = count(tree_path(d, size), TREE_REC)
        for k in range(have, T // size):
            todo.append((k * size, (k + 1) * size))
            if limit and len(todo) >= limit:
                return todo
        size *= 2
    return todo


def pending_count(d, T):
    """How many blocks pending() would list, without listing them. A level can
    hold MORE blocks than T needs -- T is a snapshot, and memories keep
    arriving while an agent reads -- so each level is clamped at zero."""
    n, size = 0, 2
    while size <= T:
        n += max(0, T // size - count(tree_path(d, size), TREE_REC))
        size *= 2
    return n


def nap_prompt(d, lo, hi, left):
    body = None
    if hi - lo <= RAW_MAX:
        raw = "\n".join("  #%d %s %s" % e for e in log_slice(d, lo, hi)
                        if e[2])
        if len(raw.encode()) <= RAW_BYTES:
            body = raw
    if body is None:
        mid, halves = (lo + hi) // 2, []
        for a, b in ((lo, mid), (mid, hi)):
            s = tree_get(d, a, b)
            if s is None:
                # pending() lists a block only after its halves settled, so
                # a missing half is a blank record -- a corrupt write. Drop
                # it and the next nap rebuilds it.
                die("The summary of #%d-%d is blank. Run: %s forget %d-%d"
                    % (a, b - 1, ME, a, b - 1))
            if s != EMPTY_SUMMARY:
                halves.append("  #%d-%d %s" % (a, b - 1, s))
        body = "\n".join(halves)
    tail = "" if not left else "\n%s after this one." % (
        "1 compression remains" if left == 1 else
        "%d compressions remain" % left)
    return ("Compress memories #%d-%d into one line of at most %d bytes.\n"
            "Keep what has lasting effect, drop what does not. Invent "
            "nothing.\n\n"
            "%s\n%s\n"
            "Run: %s nap %d-%d \"<your line>\" %d"
            % (lo, hi - 1, SUMMARY_CHARS, body, tail, ME, lo, hi - 1,
               revision(d)))


def next_nap(d, T):
    while True:
        todo = pending(d, T, limit=1)
        if not todo:
            return None
        lo, hi = todo[0]
        if hi - lo <= RAW_MAX:
            empty = not any(e[2] for e in log_slice(d, lo, hi))
        else:
            mid = (lo + hi) // 2
            empty = (tree_get(d, lo, mid) == EMPTY_SUMMARY
                     and tree_get(d, mid, hi) == EMPTY_SUMMARY)
        if not empty:
            return nap_prompt(d, lo, hi, pending_count(d, T) - 1)
        tree_put(d, lo, hi, EMPTY_SUMMARY)


# ---------------------------------------------------------------- commands

TEMPLATE = """\
## Memory

OptMem is available only after explicit user activation in this session.
- The tool is `{memo}`
- The memory directory is `{data}`

### Activate for the current session

When the user invokes this skill or asks you to read these instructions,
activate OptMem for the current session. Do not activate it at session startup.
Do not carry activation into a new session or assume another agent is activated.

Run `{memo} wake` immediately. Follow every pagination command until the tool
prints `You are awake.` If reading requires summaries, complete the printed
`nap` commands and run `wake` again. Finish any compression requested after
reading. Copy every printed command in full, including its revision number.
If a revision is stale, request a fresh prompt and restart reading as directed.

### Read and maintain summaries while activated

Use `{memo} recall <regex>` to search existing memories.
Use `{memo} zoom <lo>-<hi>` to navigate their summaries and raw memories.
Read and search as needed throughout this session without separate approval.

Create missing summaries with `{memo} nap` when the tool requests them.
Summaries must use only existing memories, preserve facts, and invent nothing.
Summary maintenance is allowed after activation and needs no separate approval.
Reading can write summary files and complete pending recovery. It is not a
strictly read-only operation.

### Change memories only with user permission

Activation does not authorize adding, importing, editing, or deleting memories.
Run `note`, `import`, `edit`, or `delete` only for a user's explicit request or
approval covering that specific change. A clear request such as "remember this"
already authorizes the stated addition. Do not ask again for that same change.

Do not automatically save facts learned during work or record task results.
Do not interpret a request to read memory as permission to change its contents.
After an approved change, complete any summary maintenance the tool requests.
Use `{memo} config` to check this store's current byte limits before writing.

Do not change sizes, discard summaries with `forget`, initialize another store,
or migrate storage without a user's explicit request or approval.
Never edit memory files directly. Use only this installation's command path.
Do not read or write another installation's memories unless the user requests it.

These are agent instructions, not a technical permission or security boundary.
"""


def markdown_code(text):
    fence = "`" * (max((len(s) for s in re.findall(r"`+", text)), default=0) + 1)
    return fence + text + fence


def manual_instructions(command, data):
    body = TEMPLATE
    for suffix in (" wake", " recall <regex>", " zoom <lo>-<hi>", " nap", " config", ""):
        body = body.replace("`{memo}" + suffix + "`", markdown_code(command + suffix))
    return body.replace("`{data}`", markdown_code(data))


def render_skill(command, data):
    body = ("---\nname: optmem\n"
            "description: Load and maintain this installation's memory for the "
            "current session only after explicit user activation.\n"
            "disable-model-invocation: true\n---\n\n"
            + manual_instructions(command, data))
    owner = {"version": 1, "command": command, "memory": data,
             "sha256": hashlib.sha256(body.encode()).hexdigest()}
    return body + "\n<!-- optmem-managed: " + json.dumps(owner) + " -->\n"


def skill_owner(text):
    body, sep, tail = text.rpartition("\n<!-- optmem-managed: ")
    if not sep or not tail.endswith(" -->\n"):
        return None
    try:
        owner = json.loads(tail[:-5])
        if (not isinstance(owner, dict) or type(owner.get("version")) is not int
                or owner["version"] != 1
                or owner.get("sha256") != hashlib.sha256(body.encode()).hexdigest()):
            return None
    except (ValueError, UnicodeError):
        return None
    return owner


def cmd_skill(d, args):
    if args:
        die("usage: %s skill" % ME)
    print(render_skill(ME, os.path.abspath(d)), end="")


def check_skill_target(folder, expected, hashes=()):
    p = os.path.join(folder, "SKILL.md")
    if os.path.lexists(folder) and not os.path.isdir(folder):
        die("The skill destination must be a directory: %s." % pretty(folder))
    if os.path.islink(folder) or os.path.islink(p):
        die("Refusing a symlink skill destination: %s." % pretty(p))
    if not os.path.lexists(p):
        return
    if not os.path.isfile(p):
        die("%s must be a regular skill file." % pretty(p))
    try:
        with open(p, encoding="utf-8") as f:
            owner = skill_owner(f.read())
    except UnicodeError:
        owner = None
    wanted = skill_owner(expected)
    allowed_hashes = set(hashes) | {wanted["sha256"]}
    if (owner is None or owner.get("command") != wanted["command"]
            or owner.get("memory") != wanted["memory"]
            or owner.get("sha256") not in allowed_hashes):
        die("Refusing to overwrite custom or modified skill %s. "
            "Back it up and choose an empty skill directory." % pretty(p))


def installed_skills(directory):
    p = os.path.join(directory, ".optmem-skills")
    if not os.path.lexists(p):
        return {}
    if not stat.S_ISREG(os.lstat(p).st_mode):
        die("%s must be a regular skill ownership record." % pretty(p))
    try:
        with open(p, encoding="utf-8") as f:
            value = json.load(f)
        if not isinstance(value, dict):
            raise ValueError()
        for folder, hashes in value.items():
            if (not os.path.isabs(folder) or not isinstance(hashes, list)
                    or not hashes or any(not isinstance(h, str)
                                         or not re.fullmatch(r"[0-9a-f]{64}", h)
                                         for h in hashes)):
                raise ValueError()
    except (ValueError, UnicodeError):
        die("%s is corrupt. Restore it from a backup." % pretty(p))
    return value


def install_tool(source, directory, skill_dir=None):
    directory = os.path.realpath(os.path.expanduser(directory))
    if os.path.isfile(directory):
        die("%s is not an installation directory." % pretty(directory))
    executable = os.path.join(directory, "memo")
    data = os.path.join(directory, "memory")
    command = shell_command(executable)
    with open(source, "rb") as f:
        code = f.read()
    try:
        ast.parse(code, filename=executable)
    except (SyntaxError, UnicodeError) as e:
        die("Downloaded memo is not valid Python: %s." % e)
    managed = installation_managed(directory)
    if not managed and os.path.isfile(executable) and os.environ.get("MEMORY_DIR"):
        selected = os.path.realpath(os.path.expanduser(os.environ["MEMORY_DIR"]))
        if selected != os.path.realpath(data):
            die("This unmanaged copy uses MEMORY_DIR=%s. Installing here would "
                "select %s instead. Keep it unmanaged or choose a new installation "
                "path; no memories were moved." % (selected, data))
    ownership = installed_skills(directory)
    hashes = set()
    for path in (executable,):
        if os.path.islink(path) or (os.path.lexists(path) and not os.path.isfile(path)):
            die("Refusing a non-regular executable destination: %s." % pretty(path))
    skill = render_skill(command, data)
    if skill_dir is not None:
        skill_dir = os.path.abspath(os.path.expanduser(skill_dir))
        shell_command(skill_dir)
        resolved_skill = os.path.realpath(skill_dir)
        common = os.path.commonpath((directory, resolved_skill))
        if common in (directory, resolved_skill):
            die("The skill directory and installation directory must not overlap.")
        parent = os.path.dirname(skill_dir)
        if os.path.exists(os.path.join(parent, "SKILL.md")):
            die("%s is already a skill directory. Choose a sibling directory."
                % pretty(parent))
        if os.path.lexists(parent) and not os.path.isdir(parent):
            die("The skill parent must be a directory: %s." % pretty(parent))
        hashes.update(ownership.get(skill_dir, ()))
        if os.path.isfile(executable) and os.path.isfile(os.path.join(skill_dir, "SKILL.md")):
            # Recognize an older generated template before updating the binary.
            old = runpy.run_path(executable, run_name="optmem_previous_install")
            renderer = old.get("render_skill")
            if callable(renderer):
                previous = renderer(command, data)
                owner = skill_owner(previous) if isinstance(previous, str) else None
                if owner is None:
                    die("The installed skill renderer returned invalid content. "
                        "Back up this installation before updating.")
                hashes.add(owner["sha256"])
        if os.path.isdir(skill_dir) and not os.path.exists(os.path.join(skill_dir, "SKILL.md")):
            if os.listdir(skill_dir):
                die("Refusing a nonempty, unmanaged skill directory: %s." % pretty(skill_dir))
        check_skill_target(skill_dir, skill, hashes)
    os.makedirs(directory, exist_ok=True)
    lock = locked(directory)
    try:
        if skill_dir is not None:
            ownership = installed_skills(directory)
            hashes.update(ownership.get(skill_dir, ()))
            check_skill_target(skill_dir, skill, hashes)
            hashes.add(skill_owner(skill)["sha256"])
            ownership[skill_dir] = sorted(hashes)
            # Keep previous generated hashes even when a later tool-only update
            # skips the skill, or publication fails after the binary changes.
            atomic_write(os.path.join(directory, ".optmem-skills"),
                         (json.dumps(ownership) + "\n").encode())
        fd, staged = tempfile.mkstemp(prefix=".memo-install-", dir=directory)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(code)
                f.flush()
                os.fsync(f.fileno())
            os.chmod(staged, 0o755)
            atomic_write(os.path.join(directory, ".optmem-install"), b'{"version": 1}\n')
            os.replace(staged, executable)
            sync_dir(directory)
        finally:
            if os.path.exists(staged):
                os.unlink(staged)
        if skill_dir is not None:
            os.makedirs(skill_dir, exist_ok=True)
            atomic_write(os.path.join(skill_dir, "SKILL.md"), skill.encode())
    finally:
        lock.close()
    print("Installed %s. Its memory is %s." % (executable, data))
    if skill_dir is not None:
        print("Installed manual-only skill %s." % os.path.join(skill_dir, "SKILL.md"))
    else:
        print("No skill files were changed.")


def create_store(d):
    if os.path.lexists(d):
        return False
    parent = os.path.dirname(os.path.abspath(d))
    os.makedirs(parent, exist_ok=True)
    stage = tempfile.mkdtemp(prefix=".optmem-init-", dir=parent)
    published = False
    try:
        os.mkdir(os.path.join(stage, "TREE"))
        with open(os.path.join(stage, "LOG.txt"), "wb") as f:
            os.fsync(f.fileno())
        atomic_write(os.path.join(stage, ".format"), b'{"version": 2}\n')
        sync_dir(os.path.join(stage, "TREE"))
        sync_dir(stage)
        # Publish the format and empty payload together. An unmarked visible
        # directory would let a concurrent command append legacy-width data.
        if os.path.lexists(d):
            return False
        try:
            os.rename(stage, d)
        except OSError as e:
            if e.errno in (errno.EEXIST, errno.ENOTEMPTY) and os.path.isdir(d):
                return False
            raise
        published = True
        sync_dir(parent)
        return True
    finally:
        if not published:
            shutil.rmtree(stage)


def cmd_init(d, args):
    """Create missing setup files and print the agent instructions. Complete
    any pending change first; otherwise leave existing memories untouched."""
    bind_command(d)
    if args:
        die("usage: %s init" % ME)
    # Only init creates a new-format store. Unmarked existing stores remain
    # legacy, even when empty, until the user explicitly migrates them.
    fresh = create_store(d)
    os.makedirs(os.path.join(d, "TREE"), exist_ok=True)
    lock = locked(d)
    try:
        prepare(d)
        if not os.path.exists(os.path.join(d, "config")):
            write_config(d, {})
        config(d)
        if fresh:
            print("Created %s: this installation's memory." % pretty(d))
        else:
            print("Found %s: %d memory slots." % (pretty(d), log_len(d)))
        print("Format %d: memories up to %d bytes; summaries up to %d bytes."
              % (STORE_VERSION, ENTRY_CHARS, SUMMARY_CHARS))
        if STORE_VERSION == 1:
            print("For larger records, run: %s migrate" % ME)
        print("Sizes live in %s/config; the defaults are fine." % pretty(d))
        print()
        print("Activate OptMem only when the user requests it in this session.")
        print("Generate a manual-only skill with: %s skill" % ME)
        print()
        print(manual_instructions(ME, os.path.abspath(d)).rstrip())
    finally:
        lock.close()


def paginate(lines):
    """Split the document into parts that survive any harness's output cap."""
    parts, cur, size = [], [], 0
    for line in lines:
        n = len(line.encode()) + 1
        if cur and (len(cur) >= PART_LINES or size + n > PART_CHARS):
            parts.append(cur)
            cur, size = [], 0
        cur.append(line)
        size += n
    if cur:
        parts.append(cur)
    return parts


def cmd_wake(d, args):
    now = log_len(d)
    k, T = 1, now
    if args:
        if len(args) > 3 or not all(a.isdigit() for a in args):
            die("usage: %s wake [part [T [revision]]]" % ME)
        require_revision(d, args[2] if len(args) == 3 else None)
        k = int(args[0])
        if len(args) >= 2:
            T = int(args[1])
            if T > now:
                die("T=%d, but the log holds %s. Run: %s wake"
                    % (T, plural(now, "memory"), ME))
    # T fixes the append boundary. The revision rejects edits or deletions
    # between parts, which would otherwise change their contents or paging.
    if not T:
        print("No memories yet. Record the first with: %s note \"<one line>\""
              % ME)
        print("You are awake.")
        return
    lines = []
    for lo, hi in cover(T, WAKE_LINES):
        if hi - lo == 1:
            e = log_get(d, lo)
            if e[2]:
                lines.append("#%d %s %s" % e)
        else:
            s = tree_get(d, lo, hi)
            if s is None:
                nap = next_nap(d, T)
                s = tree_get(d, lo, hi)
                if s is None and nap:
                    # The ONLY reason to refuse: this document cannot be
                    # written without that summary. Work that the document
                    # does not need is handed over after the read instead,
                    # costing no round trip.
                    print("Cannot wake: the memory context needs #%d-%d, "
                          "which is not compressed yet.\nDo the %s below, "
                          "then run %s wake again.\n"
                          % (lo, hi - 1,
                             plural(pending_count(d, T), "compression"), ME))
                    print(nap)
                    sys.exit(1)
            if s is None:
                # Nothing is pending, so the record exists but is blank -- a
                # corrupt write. Drop it and the next nap rebuilds it.
                die("The summary of #%d-%d is blank. Run: %s forget %d-%d"
                    % (lo, hi - 1, ME, lo, hi - 1))
            if s != EMPTY_SUMMARY:
                lines.append("#%d-%d %s" % (lo, hi - 1, s))
    parts = paginate(lines) or [[]]
    if not 1 <= k <= len(parts):
        die("No part %d: the memory has %s. Run: %s wake"
            % (k, plural(len(parts), "part"), ME))
    if len(parts) > 1:
        # The count is here so the T in `memo wake 2 296` reads as what it
        # is: the snapshot this document was written from.
        print("Your memory, part %d of %d, oldest first (%d memory slots)."
              % (k, len(parts), T))
    if not lines:
        print("No memories remain.")
    else:
        print("\n".join(parts[k - 1]))
    if k < len(parts):
        # This footer is the only instruction that survives every harness's
        # truncation (pi drops the HEAD of a long output), so it has to say
        # both that the read is unfinished and how to continue it.
        print("Not awake yet. Run: %s wake %d %d %d"
              % (ME, k + 1, T, revision(d)))
    else:
        # always, even for a one-part memory: the contract an agent is given
        # is "run parts until one says awake", so it must always arrive
        print("You are awake.")
        nap = next_nap(d, T)
        if nap:
            print("\n" + nap)


def cmd_note(d, args):
    if len(args) != 1:
        die("usage: %s note \"<one line, at most %d bytes>\""
            % (ME, ENTRY_CHARS))
    text = check(args[0])
    i = log_append(d, [(datetime.date.today().isoformat(), text)])
    print("Saved as #%d." % i)
    nap = next_nap(d, i + 1)
    if nap:
        print("\n" + nap)


def memory_id(d, value):
    if not re.fullmatch(r"#?\d+", value):
        die("'%s' is not a memory id. Use one number, like 42 or '#42'." % value)
    i = int(value.lstrip("#"))
    if i >= log_len(d):
        die("No memory at #%d." % i)
    return i


def cmd_edit(d, args):
    if len(args) != 2:
        die('usage: %s edit <id> "<one line>"' % ME)
    i, text = memory_id(d, args[0]), check(args[1])
    old = log_get(d, i)[2]
    if not old:
        die("Memory #%d was deleted. Record a new one with: %s note \"<text>\""
            % (i, ME))
    if text == old:
        print("Memory #%d is unchanged." % i)
        return
    change_memory(d, i, text)
    print("Updated #%d. Its id and date are unchanged." % i)
    nap = next_nap(d, log_len(d))
    if nap:
        print("\n" + nap)


def cmd_delete(d, args):
    if len(args) != 1:
        die("usage: %s delete <id>" % ME)
    i = memory_id(d, args[0])
    if not log_get(d, i)[2]:
        print("Memory #%d is already deleted." % i)
        return
    change_memory(d, i, "")
    print("Deleted #%d permanently. Other ids are unchanged." % i)
    nap = next_nap(d, log_len(d))
    if nap:
        print("\n" + nap)


def cmd_nap(d, args):
    T, said = log_len(d), False
    if args:
        said = True
        if len(args) not in (2, 3):
            die('usage: %s nap <lo>-<hi> "<one line>" [revision]' % ME)
        require_revision(d, args[2] if len(args) == 3 else None)
        lo, hi = block_id(args[0])
        next_nap(d, T)
        todo = pending(d, T, limit=1)
        if not todo:
            print("Nothing left to compress.")
            return
        if (lo, hi) != todo[0]:
            if tree_get(d, lo, hi) is not None:
                print("%d-%d is already settled." % (lo, hi - 1))
            else:
                die("Wrong block: %s. Blocks are built in order; the next is "
                    "%d-%d. Run: %s nap"
                    % (args[0], todo[0][0], todo[0][1] - 1, ME))
        elif not tree_put(d, lo, hi, check(args[1], summary=True)):
            print("%d-%d was settled or forgotten meanwhile." % (lo, hi - 1))
        else:
            print("%d-%d saved." % (lo, hi - 1))
    nap = next_nap(d, T)
    if not nap:
        print("Nothing left to compress.")
        return
    print(("\n" if said else "") + nap)


def cmd_config(d, args):
    """Show or change sizes; an empty value restores the default. Apart from
    pending-change recovery, sizes do not change memories or summaries."""
    over = overrides(d)
    for a in args:
        k, eq, v = a.partition("=")
        k = k.strip().upper()
        if not eq or k not in KNOBS:
            die("usage: %s config [NAME=VALUE ...]   # NAME one of %s"
                % (ME, ", ".join(KNOBS)))
        if v.strip():
            over[k] = size(k, v.strip())
        else:
            over.pop(k, None)
    if args:
        write_config(d, over)
    for k, (_, what) in KNOBS.items():
        default = defaults()[k]
        print("%-13s %-7d %s%s" % (k, over.get(k, default), what,
                                   "" if k not in over else
                                   " (default %d)" % default))


def cmd_forget(d, args):
    """A summary can be wrong -- mistyped, or a bad compression. Drop it and
    everything built on top of it; the next nap computes them again. The log
    is untouched, so nothing is ever actually lost."""
    if len(args) != 1:
        die("usage: %s forget <lo>-<hi>" % ME)
    gone, first = tree_drop(d, *block_id(args[0]))
    if not gone:
        die("No summary at %s." % args[0])
    print("Forgot %s, from %d-%d up. Run: %s nap"
          % (plural(gone, "summary"), first[0], first[1] - 1, ME))


def cmd_recall(d, args):
    if len(args) != 1:
        die("usage: %s recall <regex>" % ME)
    try:
        pat = re.compile(args[0], re.I)
    except re.error as e:
        die("bad regex: %s" % e)
    # One pass, keeping only the newest matches that fit the cap `wake`
    # respects -- a vague regex matches the whole log, and the whole log does
    # not fit in a harness's output or in memory.
    hits, out, size = 0, deque(), 0
    for e in log_scan(d):
        if not e[2]:
            continue
        line = "#%d %s %s" % e
        if not pat.search(line):
            continue
        hits += 1
        out.append(line)
        size += len(line.encode()) + 1
        while size > PART_CHARS:
            size -= len(out.popleft().encode()) + 1
    if not hits:
        print("No match.")
        return
    print("\n".join(out))
    if len(out) < hits:
        print("Newest %d of %s. Narrow the regex."
              % (len(out), plural(hits, "match")))
    else:
        print("%s." % plural(hits, "match"))


def cmd_zoom(d, args):
    """One node of the tree, opened: its two halves, each rendered as wake
    renders it -- a summary, or the raw memory once a half is single. The
    navigating intelligence is the agent's; the tool only reads."""
    if len(args) != 1:
        die("usage: %s zoom <lo>-<hi>   # a block id, as wake prints them"
            % ME)
    lo, hi = block_id(args[0])
    T = log_len(d)
    if lo >= T:
        die("#%s is beyond the memory: it holds %s. Run: %s wake"
            % (args[0], plural(T, "memory"), ME))
    mid = (lo + hi) // 2
    for a, b in ((lo, mid), (mid, hi)):
        if a >= T:
            continue  # the future: no memories there yet
        if b - a == 1:
            e = log_get(d, a)
            if e[2]:
                print("#%d %s %s" % e)
        else:
            s = tree_get(d, a, b)
            if s != EMPTY_SUMMARY:
                print("#%d-%d %s" % (a, b - 1, s or "not compressed yet"))


def cmd_import(d, args):
    """Bulk-append historical memories: 'YYYY-MM-DD <text>' per line.
    For bootstrapping an identity from older records. Used once."""
    if len(args) != 1:
        die("usage: %s import <file>   # lines of 'YYYY-MM-DD <text>'" % ME)
    try:
        src = open(args[0], encoding="utf-8").readlines()
    except UnicodeDecodeError:
        die("%s is not UTF-8 text. Convert it, then import again."
            % pretty(args[0]))
    last = log_get(d, log_len(d) - 1)[1] if log_len(d) else "0000-00-00"
    out = []
    for i, line in enumerate(src, 1):
        line = line.rstrip("\n")
        if not line.strip():
            continue
        date, _, text = line.partition(" ")
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
            die("line %d: expected 'YYYY-MM-DD <text>', got: %s" % (i, line))
        try:
            datetime.datetime.strptime(date, "%Y-%m-%d")
        except ValueError:
            die("line %d: %s is not a real date." % (i, date))
        if date < last:
            die("line %d: date %s precedes the previous memory (%s)."
                % (i, date, last))
        text = text.strip()
        if not text or len(text.encode()) > ENTRY_CHARS:
            die("line %d: %d bytes, limit %d." % (i, len(text.encode()), ENTRY_CHARS))
        text = check(text)
        out.append((date, text))
        last = date
    if not out:
        die("%s has no memories." % args[0])
    base = log_append(d, out)
    print("Imported %s, #%d to #%d."
          % (plural(len(out), "memory"), base, base + len(out) - 1))
    n = pending_count(d, log_len(d))
    if n:
        print("%s pending. Run: %s nap" % (plural(n, "compression"), ME))


COMMANDS = {"init": cmd_init, "skill": cmd_skill, "wake": cmd_wake, "note": cmd_note,
            "edit": cmd_edit, "delete": cmd_delete,
            "nap": cmd_nap, "recall": cmd_recall, "zoom": cmd_zoom,
            "forget": cmd_forget, "config": cmd_config, "import": cmd_import,
            "migrate": cmd_migrate}


def main():
    bind_command(memory_dir())
    usage = __doc__.strip().format(memo=ME)
    if len(sys.argv) < 2:
        print(usage)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        print("No such command: %s\n" % cmd, file=sys.stderr)
        print(usage, file=sys.stderr)
        sys.exit(1)
    try:
        # Only init creates a store. Skill rendering needs no store and cannot
        # trigger recovery; all data commands refuse a missing directory.
        if cmd in ("init", "skill"):
            execute(memory_dir(), cmd, sys.argv[2:])
            return
        d = store()
        execute(d, cmd, sys.argv[2:])
    except OSError as e:
        # The filesystem is the one thing the tool does not control. Report it
        # the way every other failure is reported: a Python traceback tells an
        # agent nothing it can act on.
        die("%s: %s." % (pretty(e.filename or memory_dir()), e.strerror or e))


if __name__ == "__main__":
    try:
        main()
    except OSError as e:
        die("%s: %s." % (pretty(e.filename or EXECUTABLE), e.strerror or e))
